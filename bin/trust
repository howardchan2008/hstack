#!/usr/bin/env python3
"""trust - a running SCORE for this agent, with tiers that cost something.

WHY THIS EXISTS. The owner, 2026-09-06: "these days im deeply dissatisifed with ur
responses, and how u push back even if ur wrong ... devise a mechanism to punish
and reward urself, the punishment must be severe enough to correct ur behavior",
then: "actually u need a point system then, u need to be motivated to stay above a
certain standard, and maintain that standard, prevent known failure modes, and
constantly surveil for new ones".

FOUR THINGS HE ASKED FOR, AND WHERE EACH ONE LIVES.
  a point system         SCORE, 0 to 100, starts at 100, rolling 7 days
  a standard to hold     STANDARD = 85. Below it the tiers bite, in code.
  prevent known modes    DEDUCTIONS are keyed to the fault ledger's own class
                         names, and `trust sync` reads guard refusals out of the
                         live transcripts, so every blocking hook feeds the score
                         without each one having to be edited.
  surveil for new ones   `trust surveil` diffs the ledger's active classes against
                         the detectors that cover them. A class with recent hits
                         and no detector is named UNCOVERED, which is the standing
                         work item until something in the path stops it.

WHAT A PENALTY CAN BE. A model does not carry a feeling between turns, so points
alone would be theatre. Each tier therefore removes a capability, enforced by the
hooks that read this file:

  >= 85  CLEAR      normal operation
  70-84  WATCH      concede-gate demands a tool RESULT in every close-out
  50-69  PROBATION  the above, plus agent-budget closes every dispatch
  < 50   LOCKDOWN   the above, plus new-feature work is refused: clear the open
                    deductions first, and name them in the close-out

RECOVERY IS EARNED, NOT WAITED OUT. Awards need evidence: a verified correction, a
shipped fix, a newly gated failure mode. There is no passive healing, because a
clock that restores the score rewards doing nothing. Events age out after a week,
which keeps the score a picture of NOW rather than a permanent record.

    trust status [--json]        score, tier, what it costs, what clears it
    trust deduct CLASS [N] "why" record a fault (CLASS from the fault ledger)
    trust award KIND [N] "why"   record evidence of a fix
    trust strike "why"           shorthand for the repeat-correction deduction
    trust credit ["why"]         shorthand for verified-before-answering
    trust sync [--since H]       mine guard refusals from transcripts, once each
    trust surveil                classes with no detector: the new-mode hunt
    trust log [-n N] | trust clear | trust --self-test
"""
import argparse
import glob
import json
import os
import re
import subprocess
import sys
import time

STATE = os.path.expanduser("~/.claude/state")
LEDGER = os.path.join(STATE, "trust.json")

START = 100
STANDARD = 85
TIERS = ((85, "CLEAR"), (70, "WATCH"), (50, "PROBATION"), (0, "LOCKDOWN"))
EVENT_TTL_SEC = 7 * 24 * 3600      # the score is a ROLLING WEEK, not a lifetime

# Deduction weights, keyed to the fault ledger's own class names so the two stores
# cannot drift apart. Severity follows the ledger: a repeat after a correction is
# the worst, because he already spent a turn on it once.
WEIGHTS = {
    "repeated-defect-after-correction": 15,
    "claimed-without-verifying": 10,
    "ignored-what-he-already-said": 8,
    "did-not-do-what-was-asked": 8,
    "unverified-external-state": 6,
    "asked-instead-of-deciding": 5,
    "handed-work-back-that-was-mine": 5,
    "scope-drift-or-overreach": 3,
    "style-and-register": 3,
    "wrong-lane-or-rebuilt-what-exists": 3,
    "guard-block": 2,                     # a hook had to refuse the output
}
DEFAULT_DEDUCT = 5                        # an unnamed class is never free
AWARDS = {
    "verified-before-answering": 2,
    "shipped-fix": 3,
    "new-failure-mode-gated": 5,
}
DEFAULT_AWARD = 2

# class -> the detector that PREVENTS it. An empty string means nothing covers it,
# which is exactly what `surveil` exists to surface.
DETECTORS = {
    "repeated-defect-after-correction": "hooks/concede-gate.py",
    "claimed-without-verifying": "hooks/capability-claim-gate.py + STATE-VERIFY",
    "ignored-what-he-already-said": "hooks/closeout-shape.py R8",
    "did-not-do-what-was-asked": "hooks/item-coverage.py + prompt-items.py",
    "asked-instead-of-deciding": "hooks/closeout-shape.py R3/R6",
    "handed-work-back-that-was-mine": "hooks/handoff-gate.py",
    "style-and-register": "bin/copy-lint + hooks/dash-gate.sh",
    "unverified-external-state": "bin/verify-live.sh",
    "scope-drift-or-overreach": "",
    "wrong-lane-or-rebuilt-what-exists": "",
    "documented-defect-no-transcript": "",
    "retracted-judgement-in-sot": "",
}


def _now():
    return time.time()


def load(path=None):
    try:
        with open(path or LEDGER, encoding="utf-8") as fh:
            d = json.load(fh)
    except Exception:
        d = {}
    d.setdefault("events", [])
    d.setdefault("cleared_at", 0)
    d.setdefault("synced_to", 0)
    return d


def save(d, path=None):
    path = path or LEDGER
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(d, fh, indent=1)
    os.replace(tmp, path)


def live_events(d, now=None):
    now = now or _now()
    return [e for e in d["events"]
            if now - e.get("at", 0) < EVENT_TTL_SEC
            and e.get("at", 0) > d.get("cleared_at", 0)
            and e.get("kind") in ("deduct", "award")]


def score(d, now=None):
    s = START
    for e in live_events(d, now):
        s += -e.get("points", 0) if e["kind"] == "deduct" else e.get("points", 0)
    return max(0, min(START, s))


def tier(s):
    for floor, name in TIERS:
        if s >= floor:
            return name
    return "LOCKDOWN"


COSTS = {
    "CLEAR": [],
    "WATCH": ["close-outs need a tool RESULT from the same turn"],
    "PROBATION": ["close-outs need a tool RESULT from the same turn",
                  "agent dispatches are closed"],
    "LOCKDOWN": ["close-outs need a tool RESULT from the same turn",
                 "agent dispatches are closed",
                 "no new-feature work: clear the open deductions first"],
}


def open_deductions(d, now=None):
    out = {}
    for e in live_events(d, now):
        if e["kind"] != "deduct":
            continue
        c = e.get("class", "?")
        out.setdefault(c, {"n": 0, "points": 0, "last": ""})
        out[c]["n"] += 1
        out[c]["points"] += e.get("points", 0)
        out[c]["last"] = e.get("reason", "")[:120]
    return out


def _append(kind, cls, points, reason=""):
    d = load()
    d["events"].append({"kind": kind, "class": cls, "points": int(points),
                        "at": _now(), "reason": reason[:300]})
    d["events"] = d["events"][-1000:]
    save(d)
    return d


def cmd_status(a):
    d = load()
    s = score(d)
    t = tier(s)
    if getattr(a, "json", False):
        print(json.dumps({"score": s, "tier": t, "standard": STANDARD,
                          "probation": t in ("PROBATION", "LOCKDOWN"),
                          "evidence_first": t != "CLEAR",
                          "lockdown": t == "LOCKDOWN",
                          "open": open_deductions(d)}))
        return 0
    print("SCORE %d/100  tier %s  (standard %d)  %s"
          % (s, t, STANDARD, "OK" if s >= STANDARD else "BELOW STANDARD"))
    for c in COSTS[t]:
        print("  in force: " + c)
    op = open_deductions(d)
    if op:
        print("  open deductions (rolling 7d):")
        for c, v in sorted(op.items(), key=lambda kv: -kv[1]["points"]):
            print("    -%-3d %-36s %s" % (v["points"], c, v["last"]))
        print("  earn it back: trust award shipped-fix per real fix, trust credit "
              "when you verify before answering.")
    return 0


def cmd_deduct(a):
    pts = a.points if a.points is not None else WEIGHTS.get(a.cls, DEFAULT_DEDUCT)
    d = _append("deduct", a.cls, pts, a.reason)
    print("-%d  %s  ->  score %d (%s)" % (pts, a.cls, score(d), tier(score(d))))
    return 0


def cmd_award(a):
    pts = a.points if a.points is not None else AWARDS.get(a.kind, DEFAULT_AWARD)
    d = _append("award", a.kind, pts, a.reason)
    print("+%d  %s  ->  score %d (%s)" % (pts, a.kind, score(d), tier(score(d))))
    return 0


def cmd_strike(a):
    return cmd_deduct(argparse.Namespace(
        cls="repeated-defect-after-correction", points=None, reason=a.reason))


def cmd_credit(a):
    return cmd_award(argparse.Namespace(
        kind="verified-before-answering", points=None, reason=a.reason or ""))


def cmd_clear(a):
    d = load()
    d["cleared_at"] = _now()
    d["events"].append({"kind": "clear", "at": _now(), "reason": "owner override"})
    save(d)
    print("cleared by owner override, score back to %d" % score(load()))
    return 0


def cmd_log(a):
    d = load()
    for e in d["events"][-a.num:]:
        ts = time.strftime("%Y-%m-%d %H:%M", time.localtime(e.get("at", 0)))
        sign = {"deduct": "-", "award": "+"}.get(e.get("kind"), " ")
        print("%s  %s%-3s %-34s %s" % (ts, sign, e.get("points", ""),
                                       e.get("class", e.get("kind", "")),
                                       e.get("reason", "")[:90]))
    return 0


# ------------------------------------------------------------- known modes
# Every blocking hook writes its refusal into the transcript, so the score can
# read them from ONE place instead of each hook learning to report. A hook added
# next month is counted the first time it fires.
BLOCK_RE = re.compile(
    r"(CONCEDE-GATE|CLOSE-OUT SHAPE|ITEM COVERAGE|HANDING BACK WORK|"
    r"capability-claim-gate|figure-source-gate|dash-gate|copy-lint refused)", re.I)


def cmd_sync(a):
    d = load()
    since = max(d.get("synced_to", 0), _now() - a.since * 3600)
    newest, found = since, 0
    for p in glob.glob(os.path.expanduser("~/.claude/projects/*/*.jsonl")):
        try:
            if os.path.getmtime(p) < since:
                continue
        except OSError:
            continue
        try:
            fh = open(p, errors="ignore")
        except OSError:
            continue
        with fh:
            for ln in fh:
                if not BLOCK_RE.search(ln):
                    continue
                try:
                    o = json.loads(ln)
                except Exception:
                    continue
                ts = str(o.get("timestamp") or "")
                try:
                    at = time.mktime(time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S"))
                except Exception:
                    continue
                if at <= since:
                    continue
                newest = max(newest, at)
                found += 1
    if found:
        _append("deduct", "guard-block",
                WEIGHTS["guard-block"] * min(found, 5),
                "%d guard refusal(s) since the last sync" % found)
    d = load()
    d["synced_to"] = newest
    save(d)
    print("sync: %d guard refusal(s) counted, score %d (%s)"
          % (found, score(d), tier(score(d))))
    return 0


# --------------------------------------------------------------- new modes
def parse_categories(text):
    """Rows of `faults categories`: (class, lifetime, week, rectification)."""
    rows = []
    for ln in text.splitlines()[1:]:
        m = re.match(r"^(\S+)\s+(\d+)\s+(\d+)\s*(.*)$", ln.strip())
        if m:
            rows.append((m.group(1), int(m.group(2)), int(m.group(3)), m.group(4).strip()))
    return rows


def uncovered(rows):
    """Active classes with no detector, in either this file or the ledger."""
    return [r for r in rows if r[2] > 0 and not (DETECTORS.get(r[0]) or r[3])]


def cmd_surveil(a):
    try:
        out = subprocess.run([os.path.expanduser("~/bin/faults"), "categories"],
                             capture_output=True, text=True, timeout=90).stdout
    except Exception:
        out = ""
    rows = parse_categories(out)
    if not rows:
        print("surveil: the fault ledger returned no categories (is `faults` on PATH?)")
        return 1
    gaps = uncovered(rows)
    print("surveil: %d active class(es), %d with NO detector"
          % (sum(1 for r in rows if r[2] > 0), len(gaps)))
    for cls, all_n, week_n, _ in sorted(gaps, key=lambda r: -r[2]):
        print("  UNCOVERED  %-38s %4d this week, %6d lifetime" % (cls, week_n, all_n))
    if gaps:
        print("  Each line is a failure mode with nothing in the path to stop it.")
        print("  Gate one, then claim it: trust award new-failure-mode-gated 5 \"<class>: <hook>\"")
    return 0


def _self_test():
    import tempfile
    global LEDGER
    fails = []

    def ck(cond, msg):
        if not cond:
            fails.append(msg)

    with tempfile.TemporaryDirectory() as tmp:
        LEDGER = os.path.join(tmp, "trust.json")

        ck(score(load()) == START, "a fresh ledger must score %d" % START)

        # Tier boundaries, each exercised, so an off-by-one cannot hide.
        ck(tier(85) == "CLEAR" and tier(84) == "WATCH", "the 85 boundary is wrong")
        ck(tier(70) == "WATCH" and tier(69) == "PROBATION", "the 70 boundary is wrong")
        ck(tier(50) == "PROBATION" and tier(49) == "LOCKDOWN", "the 50 boundary is wrong")

        # One repeat costs 15 and lands exactly ON the standard: a band, not a
        # hair trigger. Two more and the capability loss starts.
        cmd_strike(argparse.Namespace(reason="he repeated the autocompact correction"))
        ck(score(load()) == 85, "one strike should land on 85, got %d" % score(load()))
        cmd_strike(argparse.Namespace(reason="second"))
        ck(tier(score(load())) == "WATCH", "two strikes must be WATCH")
        cmd_strike(argparse.Namespace(reason="third"))
        ck(tier(score(load())) == "PROBATION", "three strikes must be PROBATION")
        ck("agent dispatches are closed" in COSTS["PROBATION"],
           "probation must close dispatches")
        ck("no new-feature work: clear the open deductions first" in COSTS["LOCKDOWN"],
           "lockdown must stop new-feature work")

        # NEGATIVE CONTROL: awards climb back and the ceiling holds.
        for _ in range(30):
            cmd_award(argparse.Namespace(kind="shipped-fix", points=None, reason="x"))
        ck(score(load()) == START, "awards must cap at %d, got %d" % (START, score(load())))

        # NEGATIVE CONTROL: events older than the window stop counting, so the
        # score is a rolling week rather than a permanent record.
        d = load()
        for e in d["events"]:
            e["at"] = _now() - EVENT_TTL_SEC - 60
        save(d)
        ck(score(load()) == START, "expired events must not hold the score down")

        # NEGATIVE CONTROL: an unnamed class still deducts the default, so a new
        # failure mode is never silently free.
        cmd_deduct(argparse.Namespace(cls="brand-new-mode", points=None, reason="x"))
        ck(score(load()) == START - DEFAULT_DEDUCT,
           "an unknown class must take the default %d" % DEFAULT_DEDUCT)

        cmd_clear(argparse.Namespace())
        ck(score(load()) == START, "owner override must restore the score")

    # SURVEILLANCE, on a fixture rather than the live ledger: a class with hits
    # this week and no detector is UNCOVERED; one carrying a rectification is
    # not, and neither is a class that has gone quiet.
    fixture = ("category all 7d rectification\n"
               "retracted-judgement-in-sot 317 317 \n"
               "style-and-register 266 37 copy-lint + writing-style.md\n"
               "sleeping-class 12 0 \n")
    rows = parse_categories(fixture)
    names = [r[0] for r in uncovered(rows)]
    ck(names == ["retracted-judgement-in-sot"],
       "surveil must name exactly the active, undetected class, got %s" % names)

    print("trust self-test: " + ("PASS" if not fails else "FAIL"))
    for f in fails:
        print("  " + f)
    return 1 if fails else 0


def main():
    ap = argparse.ArgumentParser(description="score, tiers and surveillance for this agent")
    ap.add_argument("--self-test", action="store_true")
    sub = ap.add_subparsers(dest="cmd")
    s = sub.add_parser("status"); s.add_argument("--json", action="store_true"); s.set_defaults(fn=cmd_status)
    s = sub.add_parser("deduct"); s.add_argument("cls"); s.add_argument("points", nargs="?", type=int)
    s.add_argument("reason", nargs="?", default=""); s.set_defaults(fn=cmd_deduct)
    s = sub.add_parser("award"); s.add_argument("kind"); s.add_argument("points", nargs="?", type=int)
    s.add_argument("reason", nargs="?", default=""); s.set_defaults(fn=cmd_award)
    s = sub.add_parser("strike"); s.add_argument("reason"); s.set_defaults(fn=cmd_strike)
    s = sub.add_parser("credit"); s.add_argument("reason", nargs="?", default=""); s.set_defaults(fn=cmd_credit)
    s = sub.add_parser("sync"); s.add_argument("--since", type=float, default=24.0,
                                               help="hours to look back on a first run")
    s.set_defaults(fn=cmd_sync)
    s = sub.add_parser("surveil"); s.set_defaults(fn=cmd_surveil)
    s = sub.add_parser("clear"); s.set_defaults(fn=cmd_clear)
    s = sub.add_parser("log"); s.add_argument("-n", "--num", type=int, default=20); s.set_defaults(fn=cmd_log)
    a = ap.parse_args()
    if a.self_test:
        return _self_test()
    if not getattr(a, "fn", None):
        return cmd_status(argparse.Namespace(json=False))
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
